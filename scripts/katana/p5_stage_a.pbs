#!/bin/bash
#PBS -l select=1:ncpus=8:ngpus=1:mem=46gb:gpu_model=H200
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail

code_directory="${KATANA_P5_DIR:-/srv/scratch/z5448417/lidc-baseline-v2}"
environment_prefix="${KATANA_ENV_PREFIX:-/srv/scratch/z5448417/conda/envs/lidc-baseline-v1}"
python_binary="$environment_prefix/bin/python"
execution_config="configs/experiments/baseline_v2_reference_training_h200_warn_only.yaml"

cd "$code_directory"
export PYTHONPATH="$code_directory/src${PYTHONPATH:+:$PYTHONPATH}"
nvidia-smi
"$python_binary" -m lidc_baseline.p5_katana verify-stage-a \
  --repository-root "$code_directory"
"$python_binary" -m lidc_baseline.p5_blackbox overfit-check \
  --fold 0 \
  --device cuda \
  --samples 8 \
  --steps 40 \
  --execution-config "$execution_config" \
  --output runs/baseline_v2/blackbox/fold_0/overfit_sanity.json
"$python_binary" -m lidc_baseline.p5_blackbox preflight \
  --fold 0 \
  --execution-config "$execution_config" \
  --output runs/baseline_v2/blackbox/fold_0/preflight.json
